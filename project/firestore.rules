rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function role() { return isSignedIn() ? request.auth.token.role : null; }
    function isAdmin() { return role() == 'admin'; }
    function isCustomer() { return role() == 'customer'; }
    function isVerifiedEmail() { return isSignedIn() && request.auth.token.email_verified == true; }

    /* USERS — customers only for now (no contractor accounts until
       self-registration comes back), plus the admin account itself */
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    /* CONTRACTORS — manually created and fully controlled by the admin.
       Publicly readable when published; only the admin can write anything,
       including points, tier, verified status, and profile content. */
    match /contractors/{contractorId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();

      match /posts/{postId} {
        allow read: if get(/databases/$(database)/documents/contractors/$(contractorId)).data.published == true || isAdmin();
        allow write: if isAdmin();
      }
    }

    /* REVIEWS — still customer-driven, tied to a real quote request */
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'published' || isAdmin() || (isSignedIn() && isOwner_(resource.data.customerId));
      allow create: if isCustomer() && isVerifiedEmail()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && get(/databases/$(database)/documents/quotes/$(request.resource.data.quoteId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/quotes/$(request.resource.data.quoteId)).data.contractorId == request.resource.data.contractorId;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && isOwner_(resource.data.customerId));
    }
    function isOwner_(uid) { return isSignedIn() && request.auth.uid == uid; }

    /* QUOTES — customer requests a quote from a manually-listed contractor.
       No contractor account exists to read these directly yet, so only the
       admin and the requesting customer can read them; admin relays leads
       to the contractor by phone/WhatsApp/email in the meantime. */
    match /quotes/{quoteId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.customerId);
      allow create: if isCustomer() && isVerifiedEmail() && request.resource.data.customerId == request.auth.uid && request.resource.data.status == 'new';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /favourites/{userId}/items/{contractorId} {
      allow read, write: if isOwner_(userId);
    }

    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /services/{id} { allow read: if true; allow write: if isAdmin(); }
    match /provinces/{id} { allow read: if true; allow write: if isAdmin(); }
    match /cities/{id} { allow read: if true; allow write: if isAdmin(); }

    match /blogs/{postId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /analytics/{contractorId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions (Admin SDK) only
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
